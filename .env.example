# ---------------------------------------------------------------------------
# Abugida LMS configuration. Copy to .env for local development.
# On Cloud Run / Render / a VM, set these as environment variables instead.
# ---------------------------------------------------------------------------

# Public URL of the app (used in email links). No trailing slash.
APP_URL=http://localhost:3000
PORT=3000

# Random string, at least 32 characters. Changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The one Abugida team account. On every start the server creates it (or gives the existing
# admin this username and password) and turns off any other admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Abugida Admin

# --- Storage ---------------------------------------------------------------
# file      = JSON file in DATA_DIR (local development, or one server with a persistent disk)
# firestore = Google Cloud Firestore (recommended for production)
DATA_BACKEND=file
DATA_DIR=./data
# For DATA_BACKEND=firestore (credentials come from the environment, e.g. the Cloud Run service account):
# FIREBASE_PROJECT_ID=your-gcp-project
# FIRESTORE_DATABASE_ID=(default)
# Uploaded files (slides, homework, curricula): local (DATA_DIR/uploads) or gcs
# FILE_BACKEND=gcs
# STORAGE_BUCKET=your-project.firebasestorage.app
MAX_UPLOAD_MB=25

# --- Email (recording reminders, parent reports) ----------------------------
# Any SMTP provider works: Google Workspace (smtp-relay.gmail.com or smtp.gmail.com
# with an app password), SendGrid, Mailgun, Amazon SES, Resend…
# Without SMTP_HOST, emails are only written to the in-app email log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Abugida Education <info@abugidaeducation.com>

# --- Sign in with Google (optional) -------------------------------------------
# OAuth client ID of type "Web application" (Google Cloud console → Google Auth
# Platform → Clients). Add your site's address, and http://localhost:3000 for
# local testing, under "Authorized JavaScript origins". Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# --- AI (monthly quizzes, homework drafts, parent-report writing) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Scheduled jobs --------------------------------------------------------
# The server runs reminders/quizzes/reports itself every SCHEDULER_INTERVAL_MINUTES.
# On platforms that pause idle servers (Cloud Run), also call
#   POST {APP_URL}/api/cron/tick   with header  x-cron-secret: $CRON_SECRET
# every 10 minutes (e.g. Cloud Scheduler).
CRON_SECRET=
INTERNAL_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=10

# --- Google Drive (optional) -------------------------------------------------
# When true, students with a Google account on file get view access to a
# recording on Drive that expires after the viewing window. Share each
# student's folder with the server's service account (as Editor).
GOOGLE_DRIVE_ENABLED=false
