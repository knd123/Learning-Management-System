{
  "name": "abugida-lms",
  "private": true,
  "version": "1.0.0",
  "description": "Abugida Education learning management system for students (grades 3-12), mentors and the Abugida team.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./data --ignore ./src server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && esbuild server/scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/seed.js",
    "start": "NODE_ENV=production node dist/server/index.js",
    "seed:demo": "tsx server/scripts/seed.ts --demo",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "express": "^4.22.3",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^9.15.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.12",
    "lucide-react": "^0.546.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.4.4"
  }
}
